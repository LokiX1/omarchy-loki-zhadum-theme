{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",          // best for Kitty terminal
    "source": "~/.config/fastfetch/images/loki-zhadum.png",
    "width": 41,              // adjust to your taste
    "height": 29,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
"display": {
    "disableLinewrap": true
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "#9b2ecd"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "#9b2ecd"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "#9b2ecd"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "#9b2ecd"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "#9b2ecd"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "#9b2ecd"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "#9b2ecd"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": " OS",
      "keyColor": "#7ec8e3",
      "text": "version=$(omarchy-version) && echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "#7ec8e3",
      "text": "omarchy-version-branch"
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "#7ec8e3",
      "text": "channel=$(omarchy-version-channel); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#7ec8e3"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "#7ec8e3"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "#7ec8e3"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#7ec8e3"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "#7ec8e3"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#7ec8e3"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "#7ec8e3",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "#7ec8e3"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "#c060e0",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "#c060e0"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "#c060e0",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
