[Unit]
Description=Zhadum per-monitor wallpapers (mpvpaper keep-alive)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.config/hypr/zhadum-wallpapers-service.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
